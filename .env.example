# Optional overrides for compose.yaml. Airwise needs no secrets: the provider is keyless.
# live = call Open-Meteo with caching; snapshot = serve the bundled snapshot only (no network).
AIRWISE_PROVIDER_MODE=live
AIRWISE_DISPLAY_TIMEZONE=Asia/Jerusalem
# Seconds a successful fetch counts as fresh, and the scheduled refresh interval.
AIRWISE_FRESH_TTL_S=1800
AIRWISE_REFRESH_INTERVAL_S=3600
